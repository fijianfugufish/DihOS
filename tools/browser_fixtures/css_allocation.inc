#define CSS_ALLOCATION_TEST_HTML "<div id=\"css-allocation-result\" style=\"position:absolute;left:600px;top:330px;width:20px;height:20px;background:#ff0000\"></div>\n<svg id=\"css-size-icon\" viewBox=\"0 0 24 24\" style=\"position:absolute;left:560px;top:380px;width:100%;height:auto\"><path d=\"M2 2H22V22H2Z\"/></svg>\n<div id=\"css-size-menu\" style=\"position:absolute;left:560px;top:410px\">Language menu</div>\n<script>\naddEventListener('load', function () {\n    const result = document.getElementById('css-allocation-result');\n    try {\n        // Larger than the captured 3.8 MB YouTube sheet. Its pessimistic token\n        // reservation exceeds the old 16 MiB guard but fits the bounded update.\n        const supported = document.createElement('style');\n        supported.textContent = ' '.repeat(4 * 1024 * 1024) + '#css-allocation-result{background:#24ac68 !important}#css-size-icon{width:24px!important;height:24px!important}#css-size-menu{display:none}';\n        document.head.appendChild(supported);\n        if (getComputedStyle(result).backgroundColor !== 'rgb(36, 172, 104)') throw Error('larger CSS allocation failed');\n        const icon = document.getElementById('css-size-icon').getBoundingClientRect();\n        if (Math.abs(icon.width - 24) > 0.01 || Math.abs(icon.height - 24) > 0.01) throw Error('large stylesheet SVG sizing failed');\n        if (getComputedStyle(document.getElementById('css-size-menu')).display !== 'none') throw Error('large stylesheet menu visibility failed');\n        // The token reservation now exceeds the explicit parser allowance.\n        // It must reject this input, not dereference a null tokenizer.\n        const huge = ' '.repeat(7 * 1024 * 1024);\n        const rejected = document.createElement('style');\n        rejected.textContent = huge + '#css-allocation-result{background:red !important}';\n        document.head.appendChild(rejected);\n        const detached = document.createElement('div');\n        detached.setAttribute('style', huge + 'color:red');\n        detached.style.cssText = huge + 'color:red';\n        detached.style.setProperty('--oversized', huge + 'red');\n        detached.style.setProperty('background-image', huge + 'url(example.invalid)');\n        let rejectedRule = false;\n        try { supported.sheet.insertRule(huge + '.ignored{color:red}', 0); } catch (e) { rejectedRule = e.name === 'SyntaxError'; }\n        if (!rejectedRule) throw Error('oversized rule admitted');\n        if (getComputedStyle(result).backgroundColor !== 'rgb(36, 172, 104)') throw Error('rejected sheet changed prior style');\n        window.cssAllocationPassed = true;\n        console.error('CSS large sheet: 4 MiB rules, 24px SVG, hidden menu and bounded rejection OK');\n        console.error('CSS allocation fixture passed');\n    } catch (e) {\n        result.style.setProperty('background', 'red', 'important');\n        console.error('CSS allocation fixture: ' + e.message);\n    }\n});\n</script>\n"
