#define BLOB_TEST_HTML "<div id=\"blob-result\" style=\"position:absolute;left:600px;top:275px;width:20px;height:20px;background:#ff0000\"></div>\n<script>\naddEventListener('load', async function () {\n    let foreignDenied;\n    const foreign = new Promise(resolve => { foreignDenied = resolve; });\n    addEventListener('message', e => {\n        if (e.origin === 'https://captcha.example' && e.data === 'blob-denied') foreignDenied();\n    });\n    const read = blob => new Promise((resolve, reject) => {\n        const reader = new FileReader();\n        reader.onload = () => resolve(reader.result);\n        reader.onerror = () => reject(new Error('FileReader'));\n        reader.readAsArrayBuffer(blob);\n    });\n    const xhrText = url => new Promise((resolve, reject) => {\n        const xhr = new XMLHttpRequest(); xhr.open('GET', url);\n        xhr.onload = () => resolve(xhr.responseText);\n        xhr.onerror = () => reject(new Error('blob XHR'));\n        xhr.send();\n    });\n    try {\n        console.error('Blob probe phase: binary');\n        const blob = new Blob([new Uint8Array([0, 1, 127, 128, 255])], {type:'application/octet-stream'});\n        if (blob.size !== 5 || blob.type !== 'application/octet-stream') throw Error('blob metadata');\n        const bytes = new Uint8Array(await read(blob.slice(1, 4)));\n        if (bytes.join(',') !== '1,127,128') throw Error('blob slice');\n        console.error('Blob probe phase: URL reads');\n        const url = URL.createObjectURL(new Blob(['owned ', 'memory'], {type:'text/plain'}));\n        if (await xhrText(url) !== 'owned memory') throw Error('blob XHR text');\n        if (await (await fetch(url)).text() !== 'owned memory') throw Error('blob fetch text');\n        console.error('Blob probe phase: origin');\n        document.querySelectorAll('iframe')[1].contentWindow.postMessage({blobProbe:url}, 'https://captcha.example');\n        await foreign;\n        console.error('Blob probe phase: revoke');\n        URL.revokeObjectURL(url);\n        let revoked = false;\n        try { await fetch(url); } catch (e) { revoked = true; }\n        if (!revoked) throw Error('revoked URL still readable');\n        console.error('Blob probe phase: image');\n        const imageURL = URL.createObjectURL(new Blob([\n            '<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\"><rect width=\"20\" height=\"20\" fill=\"#24ac68\"/></svg>'\n        ], {type:'image/svg+xml'}));\n        const image = new Image();\n        image.style.display = 'block';\n        image.width = image.height = 20;\n        await new Promise((resolve, reject) => { image.onload = resolve; image.onerror = reject; image.src = imageURL; });\n        document.getElementById('blob-result').appendChild(image);\n        URL.revokeObjectURL(imageURL);\n        console.error('Blob probe phase: done');\n    } catch (e) { console.error('Blob fixture: ' + (e.message || e)); }\n});\n</script>\n"
